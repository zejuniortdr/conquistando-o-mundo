---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Mapa from "../../../components/Mapa.astro";
import { aoRedor, parCoordenadas } from "../../../lib/geo";
import { CONTINENTES } from "../../../consts";
import { bandeira, dias, partes, quando, rota, todas, url } from "../../../lib/cidades";

export const getStaticPaths: GetStaticPaths = async () => {
  const cidades = await todas();
  return cidades.map((cidade, i) => {
    const { continente, paisSlug, cidadeSlug } = partes(cidade);
    return {
      params: { continente, pais: paisSlug, cidade: cidadeSlug },
      props: { cidade, anterior: cidades[i - 1] ?? null, proxima: cidades[i + 1] ?? null },
    };
  });
};

const { cidade, anterior, proxima } = Astro.props;
const d = cidade.data;
const meta = CONTINENTES[partes(cidade).continente];
const { Content } = await render(cidade);

const [lat, lon] = d.coordenadas;
const coord = parCoordenadas(d.coordenadas);
const recorte = aoRedor(lat, lon);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`;

const ficha = [
  ["Coordenadas", coord],
  ["Tempo em campo", `${dias(cidade)} dias`],
  ["Quando", quando(cidade)],
  ["Moeda", d.moeda],
  ...(d.custoDia ? [["Custo por dia", d.custoDia]] : []),
] as [string, string][];

const logistica = [
  ["Como chegar", d.logistica?.comoChegar],
  ["Transporte interno", d.logistica?.transporte],
  ["Onde ficar", d.logistica?.hospedagem],
  ["Visto", d.visto],
  ["Documentos", d.logistica?.documentos],
  ["Tomada e chip", d.logistica?.tomadaChip ?? d.tomada],
  ["Idioma", d.idioma],
  ["Melhor época", d.melhorEpoca],
].filter(([, v]) => v) as [string, string][];
---
<Base titulo={d.titulo} descricao={d.resumo}>
  <div class="wrap">
    <nav class="trilha" aria-label="Trilha de navegação">
      <a href={url()}>Tabuleiro</a><i></i>
      <a href={url(`${partes(cidade).continente}/`)}>{meta.nome}</a><i></i>
      <span>{bandeira(d.paisCodigo)} {d.pais}</span>
    </nav>

    <div class="capa" style={d.capa ? undefined : `background:linear-gradient(160deg, var(--c-${meta.classe}) 0%, #061419 82%)`}>
      {d.capa && <Image src={d.capa} alt={`${d.titulo}, ${d.pais}`} widths={[720, 1200, 1600]} loading="eager" fetchpriority="high" />}
      <div class="capa-txt">
        <h1>{d.titulo}</h1>
        <p>{d.pais} · {meta.nome}</p>
      </div>
    </div>

    <dl class="tarja-forte">
      {ficha.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}
    </dl>

    <div class="corpo">
      <article class="texto">
        <Content />

        {d.pontos.length > 0 && (
          <>
            <h2>Pontos visitados</h2>
            <ul class="pontos">
              {d.pontos.map((p) => (
                <li><h3>{p.nome}</h3><p>{p.resumo}</p></li>
              ))}
            </ul>
          </>
        )}

        {d.curadoria && (
          <div class="objetivo">
            <div class="rot"><i></i><span>Carta de objetivo</span></div>
            <dl>
              {d.curadoria.valeSe && <div><dt>Vale a pena se…</dt><dd>{d.curadoria.valeSe}</dd></div>}
              {d.curadoria.podePular && <div><dt>Pode pular…</dt><dd>{d.curadoria.podePular}</dd></div>}
            </dl>
          </div>
        )}
      </article>

      <aside>
        <div class="caixa">
          <h2>Onde fica</h2>
          <div class="mapa-cidade grade-geo">
            <Mapa caixa={recorte} />
            <span class="aqui"></span>
            <span class="sel">{coord}</span>
          </div>
          <a class="acao" href={mapsUrl} target="_blank" rel="noopener">Abrir no Google Maps</a>
        </div>

        {logistica.length > 0 && (
          <div class="caixa">
            <h2>Logística</h2>
            <dl>
              {logistica.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}
            </dl>
          </div>
        )}

        <div class="caixa">
          <h2>Curadoria</h2>
          <div class="nota" aria-label={`Nota ${d.nota} de 5`}>
            {[1, 2, 3, 4, 5].map((n) => <i class={n <= d.nota ? "cheia" : ""}></i>)}
          </div>
          <div class="tags">{d.tags.map((t) => <b>{t}</b>)}</div>
        </div>
      </aside>
    </div>

    <nav class="vizinhos" aria-label="Conquistas vizinhas">
      {anterior
        ? <a href={rota(anterior)}><small>← Conquista anterior</small><strong>{anterior.data.titulo}</strong></a>
        : <span><small>Início da campanha</small></span>}
      {proxima
        ? <a href={rota(proxima)}><small>Conquista seguinte →</small><strong>{proxima.data.titulo}</strong></a>
        : <span><small>Fronteira atual</small></span>}
    </nav>
  </div>
</Base>
